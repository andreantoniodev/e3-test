# API
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mini_crm?schema=public
CORS_ORIGIN=http://localhost:5173

# Firebase Admin (API) — service account do Firebase Console
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Seed: unidade.a@example.com / unidade.b@example.com
# Troque pelos e-mails Google reais antes do login

# Evolution API (v2)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me
WEBHOOK_SECRET=change-me
# API no host + Evo no Docker: http://host.docker.internal:3000
# API no Compose: http://api:3000
PUBLIC_API_URL=http://host.docker.internal:3000
RUN_SEED=true
ADMIN_SECRET=change-me

# Web (Vite) — também em apps/web/.env
VITE_API_URL=http://localhost:3000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
