# Variáveis para colar no Coolify (Environment Variables).
# Gerados pelo Coolify (não criar na mão):
#   SERVICE_PASSWORD_POSTGRES
#   SERVICE_URL_API_3000
#   SERVICE_URL_EVOLUTION_API_8080
#
# No painel, atribua FQDN:
#   api           → porta 3000
#   evolution-api → porta 8080

# Obrigatórias
CORS_ORIGIN=https://e3minicrm.web.app
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Cole a private key numa linha, com \n literais entre as linhas do PEM:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
EVOLUTION_API_KEY=
WEBHOOK_SECRET=
ADMIN_SECRET=

# Opcionais
POSTGRES_USER=postgres
POSTGRES_DB=mini_crm
RUN_SEED=true
